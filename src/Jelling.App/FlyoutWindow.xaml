<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Jelling.App.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Jelling.App"
    Title="Jelling Battery Monitor">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>
    <Grid
        x:Name="Root"
        Padding="8,8,8,8"
        KeyDown="OnRootKeyDown"
        RowDefinitions="Auto,*,Auto">
        <Grid Margin="12,0,0,4" ColumnDefinitions="*,Auto">
            <TextBlock
                x:Uid="FlyoutHeader"
                VerticalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}" />
            <Button
                x:Uid="CloseButton"
                Grid.Column="1"
                Width="32"
                Height="32"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                Click="OnCloseClick">
                <FontIcon FontSize="12" Glyph="&#xE711;" />
            </Button>
        </Grid>
        <TextBlock
            x:Name="EmptyText"
            x:Uid="EmptyText"
            Grid.Row="1"
            Margin="12,4,12,12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
        <ListView
            x:Name="DeviceList"
            Grid.Row="1"
            IsItemClickEnabled="False"
            SelectionMode="None">
            <!-- Sits above the threshold lists: right of it are the pin buttons (32), the column spacing (12)
                 and the item's right padding (12) -->
            <ListView.Header>
                <TextBlock
                    x:Uid="LowThresholdHeader"
                    Width="88"
                    Margin="0,0,56,2"
                    HorizontalAlignment="Right"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:DeviceItem">
                    <Grid
                        MinHeight="48"
                        Padding="0,6"
                        ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto"
                        ColumnSpacing="12">
                        <FontIcon
                            FontSize="20"
                            Glyph="{x:Bind KindGlyph}"
                            Opacity="{x:Bind Opacity}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Opacity="{x:Bind Opacity}"
                            Text="{x:Bind Name}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind Name}" />
                        <FontIcon
                            Grid.Column="2"
                            FontSize="16"
                            Glyph="{x:Bind BatteryGlyph}"
                            Opacity="{x:Bind Opacity}"
                            Visibility="{x:Bind LevelVisibility}" />
                        <FontIcon
                            Grid.Column="2"
                            FontSize="16"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Glyph="&#xE7BA;"
                            Opacity="{x:Bind Opacity}"
                            Visibility="{x:Bind LowVisibility}" />
                        <TextBlock
                            Grid.Column="3"
                            MinWidth="40"
                            Opacity="{x:Bind Opacity}"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind BatteryText}"
                            TextAlignment="Right" />
                        <ComboBox
                            Grid.Column="4"
                            Width="88"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{x:Bind LowThresholdAutomationName}"
                            DropDownClosed="OnThresholdListClosed"
                            ItemsSource="{x:Bind LowThresholdOptions}"
                            SelectedIndex="{x:Bind LowThresholdIndex}"
                            SelectionChanged="OnLowThresholdChanged"
                            ToolTipService.ToolTip="{x:Bind LowThresholdToolTip}" />
                        <Button
                            Grid.Column="5"
                            Width="32"
                            Height="32"
                            Padding="0"
                            AutomationProperties.Name="{x:Bind PinAutomationName}"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnPinClick"
                            ToolTipService.ToolTip="{x:Bind PinLabel}">
                            <FontIcon FontSize="14" Glyph="{x:Bind PinGlyph}" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <!-- Bottom right and quiet. The update link opens a fixed address, never one taken from the network -->
        <StackPanel
            Grid.Row="2"
            Margin="0,4,4,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="2">
            <HyperlinkButton
                x:Name="UpdateLink"
                MinWidth="32"
                MinHeight="32"
                Padding="0"
                VerticalAlignment="Center"
                NavigateUri="https://github.com/Gitsko/jelling/releases/latest"
                Visibility="Collapsed">
                <FontIcon FontSize="14" Glyph="&#xE896;" />
            </HyperlinkButton>
            <TextBlock
                x:Name="VersionText"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />
            <HyperlinkButton
                x:Uid="GitHubLink"
                Padding="6,2"
                VerticalAlignment="Center"
                Content="GitHub"
                FontSize="12"
                NavigateUri="https://github.com/Gitsko/jelling" />
        </StackPanel>
    </Grid>
</Window>
